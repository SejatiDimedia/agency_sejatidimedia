datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  NEW
  REVIEWING
  PROPOSAL
  WON
  LOST
  SPAM
}

enum UserRole {
  ADMIN
  CLIENT
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  service     String
  scale       String
  message     String
  status      LeadStatus @default(NEW)
  notes       String?
  honeypot    String?
  ipAddress   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  statusSetAt DateTime   @default(now())

  convertedUser   User?   @relation(fields: [convertedUserId], references: [id])
  convertedUserId String?
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String?
  role            UserRole     @default(CLIENT)
  activatedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  leads       Lead[]
  projects    Project[]
  magicTokens MagicToken[]
  comments    Comment[]
}

model MagicToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Project {
  id          String      @id @default(cuid())
  name        String
  status      String      @default("Active")
  startDate   String?
  endDate     String?
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  milestones  Milestone[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("To Do") // "To Do", "In Progress", "Done"
  dueDate     String?
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  tasks        Task[]
  deliverables Deliverable[]
  comments     Comment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  title       String
  isDone      Boolean   @default(false)
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Deliverable {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  size        Int
  mimeType    String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
